# -------------------------
# QuickOrders — .env.local.example
# -------------------------
# NOTE: Copy this file to `.env.local` for local development and replace placeholders.
# NEVER commit actual secret values to your repository.

# -------------------------
# App
# -------------------------
# Public app URL used by dev and some redirect flows (client-visible)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NODE environment
NODE_ENV=development

# -------------------------
# Anthropic (Quick Capture parser)
# -------------------------
# SERVER-ONLY: Use this key only on server endpoints (Next.js API routes / Edge Functions).
# Do NOT expose this key to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------
# Supabase (Postgres, Auth, Storage, Realtime)
# -------------------------
# Public (client) values — safe to prefix with NEXT_PUBLIC because RLS will restrict access.
# Get these from your Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-...

# SERVER-ONLY: Service role key — full DB privileges.
# Use only in server contexts (migrations, admin endpoints). Do NOT expose to the client.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-...

# Recommended storage bucket name for uploaded screenshots (used in code, not a secret)
SUPABASE_STORAGE_BUCKET=screenshots

# -------------------------
# Optional integrations (placeholders)
# -------------------------
# OCR service (if using an OCR API for screenshots) — SERVER-ONLY
OCR_API_KEY=ocr-api-key-...

# Analytics / error tracking (client-visible keys usually start with NEXT_PUBLIC_)
# e.g., Sentry DSN or Segment write key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SEGMENT_WRITE_KEY=

# -------------------------
# Local dev helpers (optional)
# -------------------------
# Short-lived secret used for local dev session signing (replace in production)
DEV_JWT_SECRET=dev-local-secret-please-change
